<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BaiTapMVC</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        nav a { margin-right: 15px; }
        .form-group { margin-bottom: 12px; }
        input.form-control { padding: 6px; width: 250px; }
        .btn { padding: 6px 14px; text-decoration: none; border: none; cursor: pointer; }
        .btn-primary { background: #0d6efd; color: white; }
        .btn-success { background: #198754; color: white; }
        table.table { border-collapse: collapse; }
        table.table th, table.table td { border: 1px solid #ccc; padding: 6px 10px; }
    </style>
</head>
<body>
    <nav>
        <a asp-controller="Account" asp-action="Login">Bài 1: Login</a>
        <a asp-controller="Book" asp-action="Index">Bài 2: Danh sách sách</a>
    </nav>
    <hr />
    <div>
        @RenderBody()
    </div>
</body>
</html>
