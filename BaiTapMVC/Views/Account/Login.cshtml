@model BaiTapMVC.Models.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<h2>Bài 1 - Form Submit cơ bản</h2>
<h3>Đăng nhập</h3>

@if (ViewBag.Message != null)
{
    <div style="color:@(ViewBag.Success ? "green" : "red"); font-weight:bold;">
        @ViewBag.Message
    </div>
}

<form asp-controller="Account" asp-action="Login" method="post">
    <div class="form-group">
        <label asp-for="Username">Username</label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" style="color:red"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" style="color:red"></span>
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</form>

<p style="margin-top:10px; color:gray">Gợi ý: admin / 123</p>
